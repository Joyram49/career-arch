{
  "compilerOptions": {
    /* Language & Environment */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",

    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "jest"],

    /* Output */
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,

    /* Strict Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    /* Additional Checks */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "ignoreDeprecations": "6.0",
    /* Module Resolution */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@config/*": ["src/config/*"],
      "@controllers/*": ["src/controllers/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@models/*": ["src/models/*"],
      "@routes/*": ["src/routes/*"],
      "@services/*": ["src/services/*"],
      "@utils/*": ["src/utils/*"],
      /* Feature modules — colocated controller/service/validation/route */
      "@modules/*": ["src/modules/*"],
      "@modules/auth/*": ["src/modules/auth/*"],
      "@modules/users/*": ["src/modules/users/*"],
      "@modules/organizations/*": ["src/modules/organizations/*"],
      "@modules/jobs/*": ["src/modules/jobs/*"],
      "@modules/applications/*": ["src/modules/applications/*"],
      "@modules/subscriptions/*": ["src/modules/subscriptions/*"],
      "@modules/incentives/*": ["src/modules/incentives/*"],
      "@modules/notifications/*": ["src/modules/notifications/*"],
      "@modules/uploads/*": ["src/modules/uploads/*"],
      "@modules/email/*": ["src/modules/email/*"],
      "@modules/admin/*": ["src/modules/admin/*"],
      /* Shared — cross-cutting, zero business logic */
      "@shared/*": ["src/shared/*"],
      "@shared/middlewares/*": ["src/shared/middlewares/*"],
      "@shared/utils/*": ["src/shared/utils/*"],
      "@validations/*": ["src/validations/*"],
      "@jobs/*": ["src/jobs/*"],
      "@app-types/*": ["src/types/*"],
      "@lib/*": ["src/lib/*"]
    },

    /* Experimental */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Skip Lib Checks */
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "coverage"]
}
